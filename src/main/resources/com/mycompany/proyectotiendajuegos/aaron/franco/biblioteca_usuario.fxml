<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.proyectotiendajuegos.aaron.franco.BibliotecaController"
            styleClass="main-pane">

    <!-- ══ CABECERA ══════════════════════════════════════════ -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="15">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Label text="📚 Mi Biblioteca" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblContador" styleClass="label-muted"/>
        </HBox>
    </top>

    <!-- ══ CONTENIDO CENTRAL ═════════════════════════════════ -->
    <center>
        <HBox spacing="15" styleClass="content-area">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

            <!-- Tabla de juegos de la biblioteca -->
            <TableView fx:id="tablaJuegos" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                       styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTitulo"     text="Título"      prefWidth="220"/>
                    <TableColumn fx:id="colGenero"     text="Género"      prefWidth="115"/>
                    <TableColumn fx:id="colPlataforma" text="Plataforma"  prefWidth="135"/>
                    <TableColumn fx:id="colDirector"   text="Director"    prefWidth="140"/>
                    <TableColumn fx:id="colMedia"      text="⭐ Media"    prefWidth="90"/>
                </columns>
                <placeholder>
                    <Label text="No tienes juegos en tu biblioteca todavía. ¡Visita el catálogo para comprar!"
                           styleClass="label-muted" wrapText="true"/>
                </placeholder>
            </TableView>

            <!-- Panel lateral: detalle + acciones -->
            <VBox spacing="12" prefWidth="260" minWidth="230">

                <!-- Detalle del juego seleccionado -->
                <VBox fx:id="panelDetalle" styleClass="card" spacing="8"
                      visible="false" managed="false">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <Label text="📋 Detalle" styleClass="label-section"/>
                    <HBox spacing="8">
                        <Label text="Título:"     styleClass="label-muted" minWidth="80"/>
                        <Label fx:id="lblDetTitulo" styleClass="label-normal" wrapText="true"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Género:"     styleClass="label-muted" minWidth="80"/>
                        <Label fx:id="lblDetGenero" styleClass="label-normal"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Plataforma:" styleClass="label-muted" minWidth="80"/>
                        <Label fx:id="lblDetPlat"  styleClass="label-normal" wrapText="true"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Director:"   styleClass="label-muted" minWidth="80"/>
                        <Label fx:id="lblDetDirector" styleClass="label-normal" wrapText="true"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Valoración:" styleClass="label-muted" minWidth="80"/>
                        <Label fx:id="lblDetMedia" styleClass="label-gold"/>
                    </HBox>
                    <Separator/>
                    <Button fx:id="btnVerResenas" text="💬 Ver reseñas del juego"
                            styleClass="btn-secondary" maxWidth="Infinity"
                            onAction="#verResenasSeleccionado"/>
                    <Button fx:id="btnResenar" text="✍ Escribir / editar reseña"
                            styleClass="btn-gold" maxWidth="Infinity"
                            onAction="#resenarSeleccionado"/>
                </VBox>

                <!-- Placeholder -->
                <VBox fx:id="panelVacio" styleClass="card" spacing="8" alignment="CENTER">
                    <padding><Insets top="30" right="14" bottom="30" left="14"/></padding>
                    <Label text="👈 Selecciona un juego" styleClass="label-muted"
                           wrapText="true"/>
                    <Label text="Haz clic en un juego para ver sus opciones."
                           styleClass="label-muted" wrapText="true"/>
                </VBox>

            </VBox>
        </HBox>
    </center>

    <!-- ══ PIE ════════════════════════════════════════════════ -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="header-bar">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
            <Button text="✕ Cerrar" styleClass="btn-danger" onAction="#cerrar"/>
        </HBox>
    </bottom>

</BorderPane>
