<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.proyectotiendajuegos.aaron.franco.EstadisticasAdminController"
            styleClass="main-pane">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="15">
            <Label text="📊 Estadísticas y Consultas" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblSeccion" styleClass="header-subtitle" text=""/>
            <Button text="✕ Cerrar" styleClass="btn-danger" onAction="#cerrar"/>
        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefWidth="210">
            <VBox styleClass="side-panel" spacing="5">
                <Label text="VENTAS" styleClass="label-muted"/>
                <Button text="📊 Ventas por Juego"  styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarVentas"/>
                <Button text="🔥 Más Vendidos"      styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarMasVendidos"/>

                <Label text="VALORACIONES" styleClass="label-muted" style="-fx-padding:10 0 0 0;"/>
                <Button text="⭐ Mejor Valorados"   styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarMejorValorados"/>

                <Label text="RESEÑAS" styleClass="label-muted" style="-fx-padding:10 0 0 0;"/>
                <Button text="💬 Reseñas / Idioma"  styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarResenasPorIdioma"/>
                <Button text="🎮 Reseñas / Juego"   styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarResenasPorJuego"/>
                <Button text="✍ Reseñas / Usuario"  styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarResenasPorUsuario"/>

                <Label text="USUARIOS" styleClass="label-muted" style="-fx-padding:10 0 0 0;"/>
                <Button text="🛒 Juegos / Usuario"  styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarJuegosPorUsuario"/>

                <Label text="ESTUDIOS" styleClass="label-muted" style="-fx-padding:10 0 0 0;"/>
                <Button text="🏢 Por Estudio"       styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarEstadisticasPorEstudio"/>
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>

</BorderPane>
