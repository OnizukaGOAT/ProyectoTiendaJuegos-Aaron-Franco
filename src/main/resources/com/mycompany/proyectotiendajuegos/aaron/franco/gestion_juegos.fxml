<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.proyectotiendajuegos.aaron.franco.controladores.GestionJuegosController"
            styleClass="main-pane">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="15">
            <Label text="🎮 Gestión de Juegos" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕ Cerrar" styleClass="btn-danger" onAction="#cerrar"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="15" styleClass="content-area">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

            <!-- Tabla -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Catálogo de juegos" styleClass="label-section"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Nuevo Juego" styleClass="btn-primary" onAction="#prepararAlta"/>
                </HBox>
                <TableView fx:id="tablaJuegos" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colId"        text="ID"         prefWidth="45"/>
                        <TableColumn fx:id="colTitulo"    text="Título"     prefWidth="160"/>
                        <TableColumn fx:id="colGenero"    text="Género"     prefWidth="100"/>
                        <TableColumn fx:id="colPlat"      text="Plataforma" prefWidth="130"/>
                        <TableColumn fx:id="colPrecio"    text="Precio"     prefWidth="75"/>
                        <TableColumn fx:id="colStock"     text="Stock"      prefWidth="55"/>
                        <TableColumn fx:id="colDirector"  text="Director"   prefWidth="130"/>
                        <TableColumn fx:id="colAcciones"  text="Acciones"   prefWidth="150"/>
                    </columns>
                    <placeholder><Label text="No hay juegos registrados." styleClass="label-muted"/></placeholder>
                </TableView>
            </VBox>

            <!-- Formulario -->
            <ScrollPane fitToWidth="true" prefWidth="310" minWidth="280" styleClass="scroll-pane">
                <VBox spacing="10" styleClass="card">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <Label fx:id="lblTitulo" text="Nuevo Juego" styleClass="label-section"/>

                    <Label text="Título *"     styleClass="label-normal"/>
                    <TextField fx:id="txTitulo"   promptText="Título del juego"  styleClass="text-field"/>
                    <Label text="Género"       styleClass="label-normal"/>
                    <TextField fx:id="txGenero"   promptText="Acción, RPG..."     styleClass="text-field"/>
                    <Label text="Plataforma"   styleClass="label-normal"/>
                    <TextField fx:id="txPlat"     promptText="PC, PS5..."         styleClass="text-field"/>
                    <Label text="Precio (€) *" styleClass="label-normal"/>
                    <TextField fx:id="txPrecio"   promptText="0.00"               styleClass="text-field"/>
                    <Label text="Stock *"      styleClass="label-normal"/>
                    <TextField fx:id="txStock"    promptText="0"                  styleClass="text-field"/>
                    <Label text="Director"     styleClass="label-normal"/>
                    <TextField fx:id="txDirector" promptText="Nombre del director" styleClass="text-field"/>
                    <Label text="Estudio"      styleClass="label-normal"/>
                    <ComboBox fx:id="cbEstudio" promptText="Seleccionar estudio" styleClass="combo-box" maxWidth="Infinity"/>

                    <Label fx:id="lblError" styleClass="label-accent" wrapText="true"/>
                    <HBox spacing="8">
                        <Button text="Guardar"  styleClass="btn-primary"  onAction="#guardar"  HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
