<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.proyectotiendajuegos.aaron.franco.MainUsuarioController"
            styleClass="main-pane">

    <!-- HEADER -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="15">
            <Label text="🎮 GAME PYRAMID" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblBienvenida" styleClass="header-subtitle"/>
            <Label fx:id="lblSaldo" styleClass="label-gold"/>
            <Button text="Cerrar sesión" styleClass="btn-danger" onAction="#cerrarSesion"/>
        </HBox>
    </top>

    <!-- MENÚ LATERAL -->
    <left>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefWidth="220">
            <VBox styleClass="side-panel" spacing="5">

                <Label text="CATÁLOGO" styleClass="label-muted"/>
                <Button text="🔍 Buscar Juegos"    styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarBuscarJuegos"/>
                <Button text="🎮 Todos los Juegos" styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarCatalogo"/>

                <Label text="MI CUENTA" styleClass="label-muted" style="-fx-padding:15 0 0 0;"/>
                <Button text="🛒 Mis Compras"      styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarHistorialCompras"/>
                <Button text="📚 Mi Biblioteca"    styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarBiblioteca"/>
                <Button text="✍ Mis Reseñas"       styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarMisResenas"/>
                <Button text="👤 Mi Perfil"         styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarPerfil"/>

                <Label text="CONSULTAS" styleClass="label-muted" style="-fx-padding:15 0 0 0;"/>
                <Button text="📊 Estadísticas"     styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarEstadisticas"/>

                <Label text="INFO" styleClass="label-muted" style="-fx-padding:15 0 0 0;"/>
                <Button text="❓ Ayuda"            styleClass="nav-btn" maxWidth="Infinity" onAction="#mostrarAyuda"/>

            </VBox>
        </ScrollPane>
    </left>

    <!-- ÁREA CENTRAL: bienvenida -->
    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="content-area">
            <Label text="Bienvenido a GamePyramid" styleClass="label-title"/>
            <Label text="Selecciona una opción del menú para comenzar." styleClass="label-muted"/>
        </VBox>
    </center>

</BorderPane>
